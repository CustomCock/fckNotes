# Virtuelle Umgebungen
venv/
.venv/

# Python-Artefakte
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Build-Ausgaben (PyInstaller)
build/
dist/

# Laufzeitdaten der portablen App (liegen neben der EXE, nicht im Repo)
config.json
data/
history/
/cache/
/stamps/
logs/
templates/

# Von build.py erzeugt
*.spec

# Eigene Schriften (z. B. SF Pro) – nie ins Repo, nie in den Build
fonts/user/

# Variablen (Textbausteine) der portablen App – können persönliche Daten enthalten
variables.json
