/* Notex – erzeugt aus tokens.py. Platzhalter: @farbe, @sp_*, @r_*, @fs_*, @ly_*.
   Ruhig, flach, matt. Rahmen nur wo Flächenkontrast nicht reicht. */

* {
    outline: none;
}

/* Schrift kommt über QApplication.setFont (fonts.ui_font), nicht aus dem QSS – sonst
   würde sie auch den Editor überschreiben, dessen Textschrift pro Datei gesetzt wird. */
QMainWindow, QWidget {
    background: @bg;
    color: @text;
}

/* ---------- Tooltips ---------- */
QToolTip {
    background: @surface;
    color: @text;
    border: 1px solid @border;
    border-radius: @r_controlpx;
    padding: @sp_xspx @sp_smpx;
    font-size: @fs_smallpx;
}

/* ---------- Seitenleiste ---------- */
QWidget#Sidebar, QWidget#Sidebar > QWidget {
    background: @sidebar;
}

QLineEdit {
    background: @surface;
    border: 1px solid transparent;
    border-radius: @r_controlpx;
    padding: 5px @sp_smpx;
    selection-background-color: @selection;
    selection-color: @text;
    color: @text;
}
QLineEdit:hover {
    background: @hover;
}
QLineEdit:focus {
    border: 1px solid @accent;
    background: @surface;
}
QFrame#SearchField {
    background: @surface;
    border: 1px solid transparent;
    border-radius: @r_controlpx;
}
QFrame#SearchField:hover {
    background: @hover;
}
QFrame#SearchField[focused="true"] {
    border: 1px solid @accent;
    background: @surface;
}
/* ungültige Regex / Timeout */
QFrame#SearchField[invalid="true"], QLineEdit[invalid="true"] {
    border: 1px solid @danger;
}
QLineEdit#SearchInput, QLineEdit#SearchInput:hover, QLineEdit#SearchInput:focus {
    background: transparent;
    border: none;
    padding: 0;
    border-radius: 0;
}
QLabel#SearchIcon {
    background: transparent;
}
QToolButton#SearchClear {
    background: transparent;
    border: none;
    padding: 2px;
    min-height: 0;
    border-radius: 4px;
}
QToolButton#SearchClear:hover {
    background: @selection;
}

/* Toggle-Chips (Name / Volltext) */
QToolButton#Chip {
    background: transparent;
    color: @text_muted;
    border: 1px solid @border;
    border-radius: @r_controlpx;
    padding: 2px @sp_mdpx;
    font-size: @fs_smallpx;
}
QToolButton#Chip:hover {
    color: @text;
}
QToolButton#Chip:checked {
    color: @text;
    border-color: transparent;
}
QToolButton#Chip:pressed {
    background: transparent;
}
QToolButton#Chip:focus {
    border-color: @accent;
}

/* Baum und Trefferliste: Auswahl und Hover zeichnet die View selbst (abgerundet) */
QTreeView, QTreeWidget {
    background: @sidebar;
    border: none;
    show-decoration-selected: 0;
    padding: 0 @sp_xspx;
}
QTreeView::item, QTreeWidget::item {
    border: none;
    padding: 0 @sp_xspx;
    background: transparent;
    color: @text;
}
QTreeView::item:hover, QTreeWidget::item:hover,
QTreeView::item:selected, QTreeWidget::item:selected {
    background: transparent;
    color: @text;
}
QTreeView::branch {
    background: transparent;
    image: none;
    border-image: none;
}
QHeaderView::section {
    background: @sidebar;
    color: @text_muted;
    border: none;
    padding: @sp_xspx;
}

/* ---------- Editor-Tabs ---------- */
QTabWidget::pane {
    border: none;
    background: @bg;
}
QTabBar {
    background: @bg;
    qproperty-drawBase: 0;
}
QTabBar::tab {
    background: transparent;
    color: @text_muted;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0 @sp_lgpx;
    height: 34px;
    margin: 0;
}
QTabBar::tab:hover {
    background: transparent;
    color: @text;
}
QTabBar::tab:selected {
    background: @bg;
    color: @text;
    border-bottom: 2px solid @accent;
}
QTabBar::close-button {
    image: none;
}
/* Geteilter Editor: die Gruppe ohne Fokus zeigt ihren aktiven Tab gedämpft */
QTabBar[inactive="true"]::tab:selected {
    color: @text_muted;
    border-bottom: 2px solid @text_faint;
}
QSplitter#EditorGroups::handle {
    background: @border;
}
QSplitter#EditorGroups::handle:horizontal {
    width: 1px;
}
QSplitter#EditorGroups::handle:vertical {
    height: 1px;
}

/* Das Blatt: Hintergrund transparent – die weiße Fläche mit runden Ecken malt PaperFrame */
QTextEdit#Editor {
    background: transparent;
    color: @paper_text;
    border: none;
    selection-background-color: @paper_selection;
    selection-color: @paper_text;
    /* keine font-family hier: die Textschrift setzt der Editor selbst (pro Dateiendung) */
}
QFrame#PaperFrame {
    background: @paper;
    border-radius: @r_panelpx;
}
/* Markdown-Vorschau: zweites Blatt, gleiche Farben wie der Editor */
QTextBrowser#Preview {
    background: transparent;
    color: @paper_text;
    border: none;
    selection-background-color: @paper_selection;
    selection-color: @paper_text;
}
QSplitter#PreviewSplitter::handle {
    background: transparent;
}
QWidget#EditorPage {
    background: @bg;
}

/* Suchen/Ersetzen-Leiste */
QWidget#FindBar {
    background: @sidebar;
    border-top: 1px solid @border;
}
QFrame#ReadAloudBar {
    background: @sidebar;
    border-top: 1px solid @border;
}
QWidget#FindBar QLineEdit {
    font-family: @editor_font;
    font-size: @fs_uipx;
}

/* ---------- Statusleiste ---------- */
QStatusBar {
    background: @sidebar;
    color: @text_muted;
    border-top: 1px solid @border;
    font-size: @fs_smallpx;
    min-height: @ly_status_heightpx;
    max-height: @ly_status_heightpx;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    background: transparent;
    color: @text_muted;
    font-size: @fs_smallpx;
    padding: 0 @sp_xspx;
}

/* ---------- Menüs ---------- */
QMenuBar {
    background: @bg;
    padding: 0 @sp_xspx;
}
QMenuBar::item {
    padding: @sp_xspx @sp_smpx;
    border-radius: @r_controlpx;
    color: @text_muted;
}
QMenuBar::item:selected {
    background: @hover;
    color: @text;
}
QMenu {
    background: @surface;
    border: 1px solid @border;
    border-radius: @r_panelpx;
    padding: 6px;
    margin: @sp_smpx;   /* Platz für den Schatten im transparenten Fenster */
}
QMenu::item {
    padding: 6px @sp_xlpx 6px @sp_mdpx;
    border-radius: @r_controlpx;
    color: @text;
}
QMenu::item:selected {
    background: @hover;
}
QMenu::item:disabled {
    color: @text_faint;
}
QMenu::separator {
    height: 1px;
    background: @border;
    margin: @sp_xspx @sp_smpx;
}
QMenu::icon {
    padding-left: @sp_smpx;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: @sp_xspx;
}

/* ---------- Buttons ---------- */
QPushButton, QToolButton {
    background: @surface;
    color: @text;
    border: 1px solid transparent;
    border-radius: @r_controlpx;
    padding: 5px @sp_mdpx;
    min-height: 18px;
}
QPushButton:hover, QToolButton:hover {
    background: @hover;
}
QPushButton:pressed, QToolButton:pressed {
    background: @selection;
}
QPushButton:focus, QToolButton:focus {
    border: 1px solid @accent;
}
QPushButton:default {
    border: 1px solid @accent;
}
QPushButton#Danger {
    color: @danger;
}
QPushButton#Danger:focus, QPushButton#Danger:default {
    border-color: @danger;
}
QToolButton#IconButton {
    background: transparent;
    border: 1px solid transparent;
    padding: @sp_xspx;
    min-height: 0;
}
QToolButton#IconButton:hover, QToolButton#IconButton:pressed, QToolButton#IconButton:checked {
    background: transparent;
}
QToolButton#IconButton:focus {
    border-color: @accent;
}
QTreeView:focus, QTreeWidget:focus {
    border: none;
}
QWidget#EmptyState {
    background: @bg;
}
QWidget#EmptyState QLabel {
    background: transparent;
}
QWidget#EmptyState QLabel#EmptyKey {
    background: @surface;
    border: 1px solid @border;
    color: @text_muted;
}

QSplitter::handle {
    background: @bg;
}
QSplitter::handle:horizontal {
    width: 1px;
}

/* ---------- Scrollbars: schmal, rund, halbtransparent, bei Hover deutlicher ---------- */
QScrollBar:vertical {
    background: transparent;
    width: @ly_scrollbarpx;
    margin: 2px 0;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.14);
    min-height: 32px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:vertical:pressed {
    background: rgba(255, 255, 255, 0.30);
}
QScrollBar:horizontal {
    background: transparent;
    height: @ly_scrollbarpx;
    margin: 0 2px;
}
QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.14);
    min-width: 32px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover, QScrollBar::handle:horizontal:pressed {
    background: rgba(255, 255, 255, 0.30);
}
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0;
    height: 0;
}
/* Im weißen Blatt: dunkle Scrollbar-Griffe */
QTextEdit#Editor QScrollBar::handle:vertical, QTextEdit#Editor QScrollBar::handle:horizontal,
QTextBrowser#Preview QScrollBar::handle:vertical {
    background: rgba(0, 0, 0, 0.14);
}
QTextEdit#Editor QScrollBar::handle:vertical:hover, QTextEdit#Editor QScrollBar::handle:horizontal:hover,
QTextBrowser#Preview QScrollBar::handle:vertical:hover {
    background: rgba(0, 0, 0, 0.30);
}

/* ---------- Dialoge ---------- */
QDialog, QMessageBox, QInputDialog {
    background: @surface;
}
/* Texte in Dialogen liegen auf @surface – ohne das malt die globale QWidget-Regel dunkle Kästen dahinter */
QDialog QLabel, QMessageBox QLabel, QInputDialog QLabel, QDialog QCheckBox {
    background: transparent;
}
QMessageBox QLabel, QInputDialog QLabel {
    color: @text;
    background: transparent;
}
QDialogButtonBox QPushButton, QMessageBox QPushButton {
    min-width: 88px;
}
QCheckBox {
    spacing: 6px;
    color: @text_muted;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @border;
    border-radius: 4px;
    background: @surface;
}
QCheckBox::indicator:checked {
    background: @accent;
    border-color: @accent;
    image: url(@img_check);
}
QCheckBox::indicator:indeterminate {
    background: @accent;
    border-color: @accent;
    image: url(@img_minus);
}
QCheckBox:checked {
    color: @text;
}

/* ---------- Empty State / Toast ---------- */
QLabel#EmptyTitle {
    color: @text;
    font-size: @fs_titlepx;
    font-weight: 600;
}
QLabel#EmptyHint {
    color: @text_muted;
    font-size: @fs_smallpx;
}
QLabel#EmptyKey {
    color: @text;
    background: @surface;
    border-radius: 4px;
    padding: 1px 6px;
    font-size: @fs_smallpx;
}
QFrame#Toast {
    background: @surface;
    border: 1px solid @border;
    border-radius: @r_panelpx;
}
QFrame#Toast QLabel {
    background: transparent;
    color: @text;
}

/* ---------- Seitenleiste: Hinweise ---------- */
QLabel#TreeHint {
    color: @text_faint;
    background: transparent;
    font-size: @fs_smallpx;
}
QLabel#ResultsInfo {
    color: @text_muted;
    background: transparent;
    font-size: @fs_smallpx;
    padding-right: @sp_xspx;
}
QLabel#StatusDot {
    color: @text_faint;
    padding: 0;
}

/* ---------- Einstellungen ---------- */
QDialog#SettingsDialog {
    background: @bg;
}
QListWidget#SettingsCategories {
    background: @sidebar;
    border: none;
    padding: @sp_smpx;
    font-size: @fs_uipx;
    outline: none;
}
QListWidget#SettingsCategories::item {
    padding: 6px @sp_smpx;
    border-radius: @r_controlpx;
    color: @text_muted;
}
QListWidget#SettingsCategories::item:hover {
    background: @hover;
    color: @text;
}
QListWidget#SettingsCategories::item:selected {
    background: @selection;
    color: @text;
}
QWidget#SettingsPage, QScrollArea {
    background: @bg;
    border: none;
}
QLabel#SettingsSection {
    color: @text;
    font-weight: 600;
    padding-bottom: @sp_xspx;
}
QLabel#SettingsNote {
    color: @text_muted;
    font-size: @fs_smallpx;
}
QFrame#SettingsFooter {
    background: @sidebar;
    border-top: 1px solid @border;
}
QComboBox, QSpinBox, QDoubleSpinBox, QFontComboBox {
    background: @surface;
    color: @text;
    border: 1px solid transparent;
    border-radius: @r_controlpx;
    padding: 4px @sp_smpx;
    min-height: 20px;
}
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    background: @hover;
}
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: @accent;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: url(@img_chevron_down);
    width: 14px;
    height: 14px;
    margin-right: 4px;
}
QComboBox QAbstractItemView {
    background: @surface;
    color: @text;
    border: 1px solid @border;
    selection-background-color: @hover;
    outline: none;
    padding: 4px;
}
QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 16px;
    border: none;
    background: transparent;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(@img_chevron_up);
    width: 12px;
    height: 12px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(@img_chevron_down);
    width: 12px;
    height: 12px;
}
QSlider::groove:horizontal {
    height: 4px;
    background: @surface;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: @accent;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background: @text;
}
QSlider::handle:horizontal:hover {
    background: @accent;
}
QListWidget {
    background: @surface;
    border: 1px solid @border;
    border-radius: @r_controlpx;
    padding: 4px;
    outline: none;
}
QListWidget::item {
    padding: 4px @sp_smpx;
    border-radius: 4px;
}
QListWidget::item:hover {
    background: @hover;
}
QListWidget::item:selected {
    background: @selection;
    color: @text;
}
QColorDialog {
    background: @bg;
}

/* Statusleiste: Sprache und Prüf-Schalter */
QToolButton#StatusLanguage {
    background: transparent;
    border: 1px solid transparent;
    color: @text_muted;
    padding: 1px 6px;
    min-height: 0;
    font-size: @fs_smallpx;
}
QToolButton#StatusLanguage:hover {
    background: @hover;
    color: @text;
}
QToolButton#StatusLanguage::menu-indicator {
    image: none;
    width: 0;
}
QStatusBar QToolButton#IconButton {
    padding: 2px;
}
QStatusBar QToolButton#IconButton:checked {
    background: @selection;
}

/* ---------- Bearbeitungsleiste über dem Blatt ---------- */
QFrame#EditorToolbar {
    background: @surface;
    border-top-left-radius: @r_panelpx;
    border-top-right-radius: @r_panelpx;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}
QFrame#EditorToolbar QWidget#ToolbarStrip, QFrame#EditorToolbar QWidget#ToolbarGroup {
    background: transparent;
}
QFrame#PaperFrame[attached="true"] {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}
QToolButton#ToolbarHandle {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    min-height: 0;
}
QToolButton#ToolbarHandle:hover {
    background: @hover;
}
QToolButton#ToolbarMenuButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: @r_controlpx;
    color: @text_muted;
    padding: 2px @sp_smpx;
    min-height: 0;
    font-size: @fs_smallpx;
}
QToolButton#ToolbarMenuButton:hover {
    background: @hover;
    color: @text;
}
QToolButton#ToolbarMenuButton::menu-indicator {
    image: none;
    width: 0;
}
QComboBox#ToolbarCombo {
    background: transparent;
    border: 1px solid transparent;
    padding: 2px @sp_smpx;
    min-height: 0;
    color: @text_muted;
    font-size: @fs_smallpx;
}
QComboBox#ToolbarCombo:hover {
    background: @hover;
    color: @text;
}
QLineEdit#ToolbarSize {
    background: transparent;
    border: 1px solid transparent;
    padding: 2px 0;
    color: @text_muted;
    font-size: @fs_smallpx;
}
QLineEdit#ToolbarSize:hover, QLineEdit#ToolbarSize:focus {
    background: @hover;
    color: @text;
}

QDialog#AboutDialog {
    background: @bg;
}
QDialog#AboutDialog QLabel {
    background: transparent;
}

/* Geöffnet-Bereich, Zuletzt geöffnet */
QToolButton#SectionHeader {
    background: transparent;
    border: none;
    color: @text_muted;
    font-size: @fs_smallpx;
    padding: 2px @sp_xspx;
    min-height: 0;
    text-align: left;
}
QToolButton#SectionHeader:hover {
    color: @text;
}
QListWidget#OpenFilesList {
    background: transparent;
    border: none;
    padding: 0;
}
QListWidget#OpenFilesList::item {
    padding: 4px @sp_xspx;
    color: @text;
}
QToolButton#RecentButton {
    background: transparent;
    border: 1px solid transparent;
    color: @text_muted;
    padding: 3px @sp_smpx;
    min-height: 0;
    font-size: @fs_smallpx;
}
QToolButton#RecentButton:hover {
    background: @surface;
    color: @text;
}
QLabel#StatusWarn {
    color: @danger;
    font-size: @fs_smallpx;
}
QDialog#RecentDialog {
    background: @bg;
}

/* Quick Open / Command Palette */
QFrame#Palette {
    background: @surface;
    border: 1px solid @border;
    border-radius: @r_panelpx;
}
QFrame#Palette QWidget {
    background: transparent;
}
QFrame#Palette QFrame#SearchField {
    background: @bg;
}
QListWidget#PaletteList {
    background: transparent;
    border: none;
    padding: 0;
}
QListWidget#PaletteList::item {
    padding: 3px @sp_smpx;
    border-radius: @r_controlpx;
    color: @text_muted;
}
QListWidget#PaletteList::item:selected {
    background: @selection;
    color: @text;
}
QLabel#PaletteHint {
    color: @text_faint;
    font-size: @fs_smallpx;
    padding: 0 @sp_xspx;
}

/* Backlinks-Panel, Autovervollständigung */
QWidget#Backlinks {
    background: @sidebar;
    border-top: 1px solid @border;
}
QLabel#SectionTitle {
    color: @text_muted;
    font-size: @fs_smallpx;
    font-weight: 600;
}
QListWidget#BacklinksList {
    background: @sidebar;
    border: none;
    padding: 0 @sp_xspx;
}
QListWidget#BacklinksList::item {
    padding: 3px @sp_xspx;
    border-radius: @r_controlpx;
    color: @text;
}
QListWidget#BacklinksList::item:selected {
    background: @selection;
}
QListWidget#CompletionPopup {
    background: @surface;
    border: 1px solid @border;
    border-radius: @r_controlpx;
    padding: 3px;
    color: @text;
}
QListWidget#CompletionPopup::item {
    padding: 3px @sp_smpx;
    border-radius: 4px;
}
QListWidget#CompletionPopup::item:selected {
    background: @selection;
}

/* ---------- Verschlüsselte Notizen: Sperrbildschirm ---------- */
QFrame#LockOverlay {
    background: @bg;
}
QFrame#LockCard {
    background: @surface;
    border: 1px solid @border;
    border-radius: @r_panelpx;
}
QFrame#LockCard QWidget {
    background: transparent;
}
QFrame#LockCard QLineEdit {
    background: @bg;
    border: 1px solid @border;
    border-radius: @r_controlpx;
    padding: @sp_smpx @sp_mdpx;
    color: @text;
}
QFrame#LockCard QLineEdit:focus {
    border: 1px solid @accent;
}
QFrame#LockCard QPushButton#Primary {
    background: @accent;
    color: @bg;
    border: none;
    border-radius: @r_controlpx;
    padding: @sp_smpx @sp_lgpx;
    font-weight: 600;
}
QFrame#LockCard QPushButton#Primary:hover {
    background: @text;
}
QLabel#LockTitle {
    color: @text;
    font-size: @fs_editorpx;
    font-weight: 600;
}
QLabel#LockError {
    color: @danger;
}

/* ---------- Nachschlage-Karte ---------- */
QFrame#LookupCard {
    background: @surface;
    border: 1px solid @border;
    border-radius: @r_panelpx;
}
QFrame#LookupCard:hover {
    background: @hover;
    border: 1px solid @accent;
}
QFrame#LookupCard QWidget, QFrame#LookupCard QScrollArea, QScrollArea#LookupScroll > QWidget > QWidget {
    background: transparent;
}
QLabel#LookupSource {
    color: @text_muted;
    font-size: @fs_smallpx;
    font-weight: 600;
    letter-spacing: 1px;
}
QLabel#LookupTitle {
    color: @text;
    font-size: @fs_editorpx;
    font-weight: 600;
}
QLabel#LookupDescription {
    color: @text_muted;
    font-style: italic;
}
QLabel#LookupBody {
    color: @text;
    font-size: @fs_uipx;
}
QLabel#LookupLinks, QLabel#LookupOpen {
    color: @text_muted;
    font-size: @fs_smallpx;
}
QFrame#LookupSkeleton {
    background: @selection;
    border-radius: 4px;
}

/* ---------- Datenansicht auf dem Blatt (CSV-Tabelle, JSON/YAML-Baum) ---------- */
QFrame#DataFrame {
    background: @paper;
    border-radius: @r_panelpx;
}
QFrame#DataBar {
    background: @surface;
    border-top-left-radius: @r_panelpx;
    border-top-right-radius: @r_panelpx;
}
QFrame#DataBar QLineEdit, QFrame#DataBar QComboBox {
    background: @bg;
}
QLabel#DataInfo {
    background: transparent;
    color: @text_muted;
    font-size: @fs_smallpx;
}
QTableView#CsvTable {
    background: @paper;
    alternate-background-color: @paper_line;
    color: @paper_text;
    gridline-color: @paper_line;
    border: none;
    selection-background-color: @paper_selection;
    selection-color: @paper_text;
}
QTableView#CsvTable QHeaderView::section {
    background: @paper;
    color: @paper_muted;
    border: none;
    border-bottom: 1px solid @paper_line;
    border-right: 1px solid @paper_line;
    padding: 2px @sp_smpx;
}
QTableView#CsvTable QHeaderView {
    background: @paper;
    border: none;
}
QTableView#CsvTable QHeaderView::section:vertical {
    border-right: 1px solid @paper_line;
    border-bottom: none;
    padding: 0 @sp_smpx;
}
QTableView#CsvTable QTableCornerButton::section {
    background: @paper;
    border: none;
}
QTableView#CsvTable QLineEdit {
    background: @paper;
    color: @paper_text;
    border: 1px solid @accent;
    border-radius: 0;
    padding: 0 2px;
    selection-background-color: @paper_selection;
    selection-color: @paper_text;
}

/* JSON/YAML-Prüfung und Dateityp-Warnung in der Statusleiste */
QToolButton#StatusProblem {
    background: transparent;
    border: none;
    border-radius: @r_controlpx;
    color: @danger;
    padding: 1px 6px;
    min-height: 0;
    font-size: @fs_smallpx;
}
QToolButton#StatusProblem[level="ok"] {
    color: @text_muted;
}
QToolButton#StatusProblem:hover {
    background: @hover;
}
QTreeWidget#DataTree {
    background: @paper;
    alternate-background-color: @paper_line;
    color: @paper_text;
    border: none;
    padding: 0;
    show-decoration-selected: 1;
    selection-background-color: @paper_selection;
    selection-color: @paper_text;
}
QTreeWidget#DataTree::item {
    color: @paper_text;
    padding: 1px @sp_xspx;
}
QTreeWidget#DataTree::item:selected, QTreeWidget#DataTree::item:selected:active {
    background: @paper_selection;
    color: @paper_text;
}
QTreeWidget#DataTree::item:hover:!selected {
    background: @paper_line;
}
QTreeWidget#DataTree::item:disabled {
    color: @paper_muted;
}
QTreeWidget#DataTree QHeaderView {
    background: @paper;
    border: none;
}
QTreeWidget#DataTree QHeaderView::section {
    background: @paper;
    color: @paper_muted;
    border: none;
    border-bottom: 1px solid @paper_line;
    padding: 2px @sp_smpx;
}
QTreeWidget#DataTree::branch:has-children:closed {
    image: url(@img_chevron_right);
}
QTreeWidget#DataTree::branch:has-children:open {
    image: url(@img_chevron_down);
}
QLabel#DataError {
    color: @paper_text;
    font-size: @fs_uipx;
    padding: @sp_lgpx;
}

/* Prüfsummen-Vergleich: grün = stimmt, rot = weicht ab */
QLabel#HashVerdict[state="ok"] {
    color: @success;
}
QLabel#HashVerdict[state="bad"] {
    color: @danger;
}
QLineEdit[state="ok"] {
    border: 1px solid @success;
}
QLineEdit[state="bad"] {
    border: 1px solid @danger;
}
/* Hex-Ansicht: gleiche Fläche wie das Blatt */
QAbstractScrollArea#HexArea {
    background: @paper;
    border: none;
    border-bottom-left-radius: @r_panelpx;
    border-bottom-right-radius: @r_panelpx;
}

/* Live verfolgen */
QPlainTextEdit#LogText {
    background: @paper;
    color: @paper_text;
    border: none;
    padding: @sp_smpx;
    selection-background-color: @paper_selection;
    selection-color: @paper_text;
}
QLabel#LiveBadge {
    color: @success;
    font-size: @fs_smallpx;
}
QPushButton#LogPaused {
    color: @warning;
}
/* PDF: Seiten auf dem dunklen Tisch, Lesezeichen links */
QAbstractScrollArea#PdfCanvas {
    background: @bg;
    border: none;
}
QTreeView#PdfOutline {
    background: @surface;
    border: none;
}
QTreeView#PdfOutline::item:selected, QTreeView#PdfOutline::item:hover {
    background: @selection;
    color: @text;
}
QLabel#HexInspector {
    background: @surface;
    color: @text_muted;
    font-size: @fs_smallpx;
    padding: @sp_xspx @sp_mdpx;
    border-bottom-left-radius: @r_panelpx;
    border-bottom-right-radius: @r_panelpx;
}
/* Analyse-Tabellen (Strings, Eingebettete Dateien) */
QTableView#AnalysisTable {
    background: @surface;
    alternate-background-color: @bg;
    gridline-color: @border;
    border: none;
    selection-background-color: @selection;
    selection-color: @text;
}
QTableView#AnalysisTable QHeaderView::section {
    background: @surface;
    color: @text_muted;
    border: none;
    border-bottom: 1px solid @border;
    padding: 2px @sp_smpx;
}
QLabel#EntropySummary {
    color: @text;
    font-size: @fs_uipx;
}
